PORT=3001
DATABASE_URL=postgresql://ear:ear_dev@127.0.0.1:5434/ear
# Use demo for the local workbench. Switch to jwt for authentication tests.
AUTH_MODE=demo
JWT_SECRET=replace-with-a-long-local-development-secret
JWT_ISSUER=enterprise-auth
JWT_AUDIENCE=enterprise-agent-runtime

# Bailian exposes an OpenAI-compatible endpoint. Omit the key to use the
# deterministic offline providers. Keep the API key and base URL in the same region.
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.7-max
OPENAI_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_WIRE_API=chat_completions
OPENAI_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Evaluation prices are explicit inputs to the report, not hard-coded claims.
EVAL_MODEL_INPUT_CNY_PER_MILLION=12
EVAL_MODEL_OUTPUT_CNY_PER_MILLION=36
EVAL_EMBEDDING_CNY_PER_MILLION=0.5

# Omit QDRANT_URL to use the in-memory vector index.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowledge_chunks_v4_1024
QDRANT_API_KEY=
KNOWLEDGE_INDEX_INTERVAL_MS=2000
SEED_DEMO_DATA=true
