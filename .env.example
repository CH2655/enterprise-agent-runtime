PORT=3001
DATABASE_URL=postgresql://ear:ear_dev@127.0.0.1:5434/ear
AUTH_MODE=jwt
JWT_SECRET=replace-with-a-long-local-development-secret
JWT_ISSUER=enterprise-auth
JWT_AUDIENCE=enterprise-agent-runtime

# Omit OPENAI_API_KEY to use the deterministic offline Model Provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256

# Omit QDRANT_URL to use the in-memory vector index.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowledge_chunks
QDRANT_API_KEY=
KNOWLEDGE_INDEX_INTERVAL_MS=2000
