{
  "name": "enterprise-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "dev:web": "pnpm --filter @ear/web dev",
    "dev:mcp": "node --env-file-if-exists=.env --import tsx mcp-servers/paas-tools/src/main.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "demo:full": "node --import tsx scripts/demo.ts --full",
    "demo:seed": "node --import tsx scripts/seed-demo.ts",
    "build:web": "pnpm --filter @ear/web build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose up -d postgres qdrant",
    "db:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run __tests__/packages/persistence/runtime.integration.test.ts",
    "test:watch": "vitest",
    "eval:m2": "node --import tsx evals/src/cli.ts --mode deterministic",
    "eval:m2:real": "node --env-file-if-exists=.env --import tsx evals/src/real-cli.ts",
    "eval:m2:e2": "node --env-file-if-exists=.env --import tsx evals/src/e2-cli.ts",
    "eval:bailian:smoke": "node --env-file-if-exists=.env --import tsx evals/src/bailian-smoke.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.2",
    "@langchain/langgraph": "1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.45.2",
    "eventsource-parser": "^4.0.0",
    "fastify": "5.11.3",
    "pg": "^8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
