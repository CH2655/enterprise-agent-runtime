{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@ear/domain": ["packages/domain/src/index.ts"],
      "@ear/agent-protocol": ["packages/agent-protocol/src/index.ts"],
      "@ear/tool-registry": ["packages/tool-registry/src/index.ts"],
      "@ear/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@ear/auth": ["packages/auth/src/index.ts"],
      "@ear/persistence": ["packages/persistence/src/index.ts"],
      "@ear/risk-agent": ["agents/risk-agent/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "agents/**/*.ts", "__tests__/**/*.ts", "drizzle.config.ts", "vitest.config.ts"]
}
